{
  "cpu.txt": {
    "command": [
      "lscpu"
    ],
    "exit": 0
  },
  "topology.txt": {
    "command": [
      "nvidia-smi",
      "topo",
      "-m"
    ],
    "exit": 0
  },
  "peer-read.txt": {
    "command": [
      "nvidia-smi",
      "topo",
      "-p2p",
      "r"
    ],
    "exit": 0
  },
  "peer-write.txt": {
    "command": [
      "nvidia-smi",
      "topo",
      "-p2p",
      "w"
    ],
    "exit": 0
  },
  "gpu-map.csv": {
    "command": [
      "nvidia-smi",
      "--query-gpu=index,uuid,pci.bus_id,name,memory.total",
      "--format=csv"
    ],
    "exit": 0
  }
}
