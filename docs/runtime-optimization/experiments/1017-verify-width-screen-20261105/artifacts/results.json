    "runtime_patch": "diff --git a/src/llama-kv-cache-dsv4.cpp b/src/llama-kv-cache-dsv4.cpp\nindex 851efb04e..3dc20a5c5 100644\n--- a/src/llama-kv-cache-dsv4.cpp\n+++ b/src/llama-kv-cache-dsv4.cpp\n@@ -2335,6 +2335,10 @@ std::vector<uint32_t> llama_kv_cache_dsv4_comp_context::get_layer_ids() const {\n     return kv->get_layer_ids();\n }\n \n+ggml_type llama_kv_cache_dsv4_comp_context::type_k() const {\n+    return kv->type_k();\n+}\n+\n ggml_tensor * llama_kv_cache_dsv4_comp_context::get_k(ggml_context * ctx, int32_t il) const {\n     return kv->get_k(ctx, il, n_kv, sinfos[i_cur]);\n }\ndiff --git a/src/llama-kv-cache-dsv4.h b/src/llama-kv-cache-dsv4.h\nindex 8fd73e60c..aeb45b2ce 100644\n--- a/src/llama-kv-cache-dsv4.h\n+++ b/src/llama-kv-cache-dsv4.h\n@@ -264,6 +264,7 @@ public:\n \n     uint32_t get_n_kv() const;\n     std::vector<uint32_t> get_layer_ids() const;\n+    ggml_type type_k() const;\n \n     ggml_tensor * get_k(ggml_context * ctx, int32_t il) const;\n     ggml_tensor * cpy_k(ggml_context * ctx, ggml_tensor * k_cur, ggml_tensor * k_idxs, int32_t il) const;\ndiff --git a/src/models/deepseek41.cpp b/src/models/deepseek41.cpp\nindex 4f64b0420..1ec7eb67b 100644\n--- a/src/models/deepseek41.cpp\n+++ b/src/models/deepseek41.cpp\n@@ -1163,7 +1163,10 @@ ggml_tensor * llama_model_deepseek41::graph::build_attention_v41(\n     if (hparams.dsv41_is_kv_source(il) && inp_comp.state_pos) {\n         const auto write_cache = [&](const auto * cache, ggml_tensor * value, uint32_t il_cache) {\n             auto * write = cache->cpy_k(ctx0, value, inp_comp.state_write_idxs, il_cache);\n-            if (defer_cache_updates && il_cache > (uint32_t) il && model.dev_layer(il_cache) != model.dev_layer(il)) {\n+            const auto * storage = write->view_src;\n+            const bool known_owner = is_dsv41_decode() || (storage && storage->buffer &&\n+                ggml_backend_buft_get_device(ggml_backend_buffer_get_type(storage->buffer)) == model.dev_layer(il_cache));\n+            if (defer_cache_updates && known_owner && il_cache > (uint32_t) il && model.dev_layer(il_cache) != model.dev_layer(il)) {\n                 cb(write, \"deferred_cache_update\", il_cache);\n                 cache_updates[il_cache].push_back(write);\n             } else {\n@@ -1457,12 +1460,49 @@ llama_model_deepseek41::graph::graph(const llama_model & model, const llm_graph_\n     ggml_tensor * top_k_carry = nullptr;\n     ggml_tensor * candidate_mask_carry = nullptr;\n     const bool is_media = ubatch.embd != nullptr || ubatch.embd_tensor != nullptr;\n-    defer_cache_updates = dsv41_default_on(\"LLAMA_DSV41_DEFER_CACHE_UPDATES\") && is_dsv41_decode() &&\n+    const char * prefill_defer = std::getenv(\"LLAMA_DSV41_PREFILL_DEFER_CACHE_UPDATES\");\n+    bool prefill_cache_updates = prefill_defer && std::strcmp(prefill_defer, \"1\") == 0 &&\n+        !is_dsv41_decode() && n_tokens > 1 && n_tokens <= 512 && ubatch.token && !is_media &&\n+        ubatch.n_seqs_unq == 1 && cparams.n_seq_max == 1 && !cparams.cb_eval &&\n+        cparams.causal_attn && cparams.flash_attn && cparams.offload_kqv && cparams.pipeline_parallel &&\n+        model.split_mode() == LLAMA_SPLIT_MODE_LAYER && model.n_gpu_layers() > hparams.n_layer_all &&\n+        inp_dsv4->mctx->get_csa() && inp_dsv4->mctx->get_lid() &&\n+        inp_dsv4->mctx->get_csa()->type_k() == GGML_TYPE_Q8_0 &&\n+        inp_dsv4->mctx->get_lid()->type_k() == GGML_TYPE_Q8_0;\n+    if (prefill_cache_updates) {\n+        const auto on_cuda = [](const ggml_tensor * tensor) {\n+            if (!tensor) {\n+                return true;\n+            }\n+            if (!tensor->buffer || ggml_backend_buffer_is_host(tensor->buffer)) {\n+                return false;\n+            }\n+            const auto dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(tensor->buffer));\n+            return dev && std::strncmp(ggml_backend_dev_name(dev), \"CUDA\", 4) == 0;\n+        };\n+        for (int il = 0; il < n_layer && prefill_cache_updates; ++il) {\n+            const auto & layer = model.layers[il];\n+            for (const auto * tensor : {layer.wq_a, layer.wq_b, layer.wkv, layer.wo_a, layer.wo_b,\n+                    layer.attn_norm, layer.attn_q_a_norm, layer.attn_kv_norm, layer.attn_comp_wkv,\n+                    layer.attn_comp_wgate, layer.attn_comp_norm, layer.indexer_attn_k, layer.indexer_attn_q_b,\n+                    layer.indexer_proj, layer.indexer_k_norm, layer.attn_sinks, layer.ffn_norm,\n+                    layer.hc_attn_fn, layer.hc_attn_base, layer.hc_attn_scale,\n+                    layer.hc_ffn_fn, layer.hc_ffn_base, layer.hc_ffn_scale, layer.ffn_gate_inp, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_gate_up_exps,\n+                    layer.ffn_down_exps, layer.ffn_gate_shexp, layer.ffn_up_shexp, layer.ffn_down_shexp}) {\n+                if (!on_cuda(tensor)) {\n+                    prefill_cache_updates = false;\n+                    break;\n+                }\n+            }\n+        }\n+    }\n+    defer_cache_updates = prefill_cache_updates || (dsv41_default_on(\"LLAMA_DSV41_DEFER_CACHE_UPDATES\") && is_dsv41_decode() &&\n         cparams.n_seq_max == 1 && cparams.offload_kqv && model.split_mode() == LLAMA_SPLIT_MODE_LAYER &&\n-        model.n_gpu_layers() > hparams.n_layer_all;\n+        model.n_gpu_layers() > hparams.n_layer_all);\n \n     for (int il = 0; il < n_layer; ++il) {\n-        if (defer_cache_updates && il > 0 && model.dev_layer(il) != model.dev_layer(il - 1)) {\n+        if (defer_cache_updates && (is_dsv41_decode() || !cache_updates.empty()) &&\n+                il > 0 && model.dev_layer(il) != model.dev_layer(il - 1)) {\n             ggml_build_forward_expand(gf, inpL);\n             ggml_build_forward_expand(gf, pre_mix);\n         }\n@@ -1507,6 +1547,13 @@ llama_model_deepseek41::graph::graph(const llama_model & model, const llm_graph_\n         cur = build_attention_v41(\n                 model, inp_dsv4, cur, inp_pos, top_k_carry, candidate_mask_carry, il);\n         if (il == prefill_kv_only_layer) {\n+            // Truncated prefill still has to populate every remote replica.\n+            for (const auto & updates : cache_updates) {\n+                for (auto * write : updates.second) {\n+                    ggml_build_forward_expand(gf, write);\n+                }\n+            }\n+            cache_updates.clear();\n             GGML_ASSERT(n_outputs == 0 && cache_updates.empty());\n             return;\n         }\n",
