+static bool ggml_backend_sched_cpu_lookups_isolated(ggml_backend_sched_t sched, std::vector<bool> & early) {
+    int cpu = -1;
+    for (int i = 0; i < sched->n_backends; ++i) {
+        auto * dev = ggml_backend_get_device(sched->backends[i]);
+        auto * reg = ggml_backend_dev_backend_reg(dev);
+        if (!reg) {
+            return false;
+        }
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            if (cpu >= 0 || strcmp(ggml_backend_reg_name(reg), "CPU") != 0) {
+                return false;
+            }
+            cpu = i;
+        } else if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+                strcmp(ggml_backend_reg_name(reg), "CUDA") != 0) {
+            return false;
+        }
+    }
+    if (cpu < 0) {
+        return false;
+    }
+    for (int i = 0; i < sched->n_backends; ++i) {
+        if (i != cpu && ggml_backend_supports_buft(sched->backends[i], sched->bufts[cpu])) {
+            return false;
+        }
+    }
+
+    const auto root_of = [](const ggml_tensor * t) {
+        while (t && t->view_src) {
+            t = t->view_src;
+        }
+        return t;
+    };
+    const auto host = [&](const ggml_tensor * t) {
+        const auto * root = root_of(t);
+        return root && root->buffer && ggml_backend_buffer_is_host(root->buffer);
+    };
+    std::unordered_set<const ggml_tensor *> lookups, exported;
+    for (int i = 0; i < sched->n_splits; ++i) {
+        const auto & split = sched->splits[i];
+        const bool on_cpu = split.backend_id == cpu;
+        if (on_cpu && split.n_inputs != 0) {
+            return false;
+        }
+        for (int j = 0; j < split.graph.n_nodes; ++j) {
+            const auto * node = split.graph.nodes[j];
+            if (ggml_is_view_op(node->op)) {
+                continue;
+            }
+            if (!on_cpu) {
+                // No device kernel may access CPU scratch directly.
+                if (node->op == GGML_OP_MUL_MAT_ID_STAGED || !node->buffer || host(node)) {
+                    return false;
+                }
+                for (const auto * src : node->src) {
+                    if (src && host(src)) {
+                        return false;
+                    }
+                }
+                continue;
+            }
+            const auto * table = node->src[0];
+            const auto * rows = root_of(node->src[1]);
+            if (node->op != GGML_OP_GET_ROWS || node->view_src || !host(node) ||
+                    (node->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT)) ||
+                    !table || table->op != GGML_OP_NONE || table->view_src || !host(table) ||
+                    ggml_backend_buffer_get_usage(table->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS ||
+                    !rows || rows->op != GGML_OP_NONE || !(rows->flags & GGML_TENSOR_FLAG_INPUT) || !host(rows)) {
+                return false;
+            }
+            for (int k = 2; k < GGML_MAX_SRC; ++k) {
+                if (node->src[k]) {
+                    return false;
+                }
+            }
+            lookups.insert(node);
+            early[i] = true;
+        }
+    }
+    if (lookups.empty()) {
+        return false;
+    }
+
+    for (int i = 0; i < sched->n_splits; ++i) {
+        const auto & split = sched->splits[i];
+        if (split.backend_id == cpu) {
+            for (int j = 0; j < split.graph.n_nodes; ++j) {
+                const auto * node = split.graph.nodes[j];
+                const auto * root = root_of(node);
+                if ((node->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+                        (ggml_is_view_op(node->op) && lookups.count(root) == 0 &&
+                         !(root->flags & GGML_TENSOR_FLAG_INPUT) &&
+                         (!host(root) || ggml_backend_buffer_get_usage(root->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS))) {
+                    return false;
+                }
+            }
+            continue;
+        }
+        for (int j = 0; j < split.n_inputs; ++j) {
+            auto * input = split.inputs[j];
+            const auto * root = root_of(input);
+            if (lookups.count(root) == 0) {
+                continue;
+            }
+            auto * stage = tensor_copy(input, cpu, sched->cur_copy);
+            auto * dst = tensor_copy(input, split.backend_id, sched->cur_copy);
+            if (!stage || stage == input || !host(stage) || stage->buffer == root->buffer ||
+                    (stage->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT)) !=
+                        (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT) ||
+                    !ggml_are_same_layout(stage, input) || !dst || !dst->buffer || host(dst)) {
+                return false;
+            }
+            exported.insert(root);
+        }
+    }
+    return exported.size() == lookups.size();
+}
