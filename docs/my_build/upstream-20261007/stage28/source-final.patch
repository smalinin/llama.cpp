+bool llama_kpool_cache::needs_rebuild(const llama_kv_cache_context & ctx, const llama_ubatch & ubatch) const {
+    const auto * kv = ctx.get_kv();
+    const uint32_t stream0 = ctx.get_stream_base();
+    const uint32_t n_stream = kv->get_n_stream() == 1 ? 1 : ubatch.n_seqs_unq;
+    if (needs_rebuild(stream0, n_stream)) {
+        return true;
+    }
+
+    GGML_ASSERT(n_stream > 0 && ubatch.n_tokens % n_stream == 0 && ubatch.n_seqs_unq % n_stream == 0);
+    const int64_t n_tps = ubatch.n_tokens/n_stream;
+    const int64_t n_ps = ubatch.n_seqs_unq/n_stream;
+    const int64_t r = pimpl->kpool;
+    const int64_t n_pools = llama_kpool_n_pools(ctx.get_n_kv(), r, n_ps);
+    const int64_t n_update = std::min<int64_t>(
+            n_pools, (n_tps + r - 1)/r + n_ps + get_max_uncached(stream0, n_stream));
+    if (n_update == n_pools) {
+        return false;
+    }
+
+    // A returning sequence can need old pools that prepare_stream evicted.
+    // Bound missing pools from resident positions before choosing the graph.
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        int64_t n_missing = 0;
+        const auto & map = pimpl->maps[stream0 + s];
+        for (int64_t ps = 0; ps < n_ps; ++ps) {
+            const llama_seq_id seq = n_ps == 1 ? ubatch.seq_id[s*n_tps][0] : ubatch.seq_id_unq[ps];
+            const auto & cells = kv->get_cells(seq);
+            const llama_pos p_min = cells.seq_pos_min(seq);
+            const llama_pos p_max = cells.seq_pos_max(seq);
+            if (p_min < 0) {
+                continue;
+            }
+            const int64_t first = p_min/r;
+            const int64_t last  = p_max/r;
+            n_missing += last - first + 1;
+            for (const auto & [id, entry] : map) {
+                if (id.seq == seq && entry.cached && id.block >= first && id.block <= last) {
+                    --n_missing;
+                }
+            }
+        }
+        if (n_missing > n_update) {
+            return true;
+        }
+    }
+    return false;
+}
